rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function getAdminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }
    function isSuperadmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && getAdminData().role == 'superadmin';
    }

    // Admins collection — read own record only
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Game Configs — superadmin writes, any signed-in user reads (players need it)
    match /gameConfigs/{configId} {
      allow read: if isSignedIn();
      allow create, update: if isSuperadmin();
      allow delete: if isSuperadmin() && resource.data.createdBy == request.auth.uid;
    }

    // Game Codes — public read; superadmin writes; players update counters
    match /gameCodes/{code} {
      allow read: if true;
      allow create: if isSuperadmin();
      allow update: if isSuperadmin()
        || (isSignedIn() &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['activeUsers', 'playsUsed']));
      allow delete: if isSuperadmin();
    }

    // Trolley Pricing Configs — same shape as gameConfigs: superadmin writes,
    // any signed-in user reads (the master admin's Game Codes/Configs tabs,
    // and the Shopping Trolley app's own superadmin test screen, both read
    // this; the import script writes via the Admin SDK, which bypasses
    // these rules entirely, but a browser-side delete still needs this).
    match /trolleyConfigs/{configId} {
      allow read: if isSignedIn();
      allow create, update: if isSuperadmin();
      allow delete: if isSuperadmin() && resource.data.createdBy == request.auth.uid;
    }

    // Trolley Sessions — same shape and reasoning as sessions below, just
    // for the Shopping Trolley game's own session/player collections.
    match /trolleySessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isSuperadmin() ||
        resource.data.adminUid == request.auth.uid ||
        // Students joining bump the session's reference-number counter
        // (joinTrolleySession) — that one field only, same pattern as
        // the player-counter exception on gameCodes above.
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['nextReferenceNumber'])
      );

      match /players/{playerId} {
        allow read, write: if isSignedIn() && request.auth.uid == playerId;
        allow read: if isSignedIn() && (
          isSuperadmin() ||
          get(/databases/$(database)/documents/trolleySessions/$(sessionId)).data.adminUid == request.auth.uid
        );
      }
    }

    // Sessions — any signed-in user can create/update (covers anonymous teachers)
    // Players are always anonymous; teachers are anonymous after our login flow
    match /sessions/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isSuperadmin() ||
        resource.data.adminUid == request.auth.uid
      );

      match /players/{playerId} {
        allow read, write: if isSignedIn() && request.auth.uid == playerId;
        allow read: if isSignedIn() && (
          isSuperadmin() ||
          get(/databases/$(database)/documents/sessions/$(sessionId)).data.adminUid == request.auth.uid
        );
        match /trades/{tradeId} {
          allow read, create: if isSignedIn() && request.auth.uid == playerId;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
